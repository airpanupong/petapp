# Backend
APP_NAME=PetApp API
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
DATABASE_URL=postgresql+psycopg://petapp:petapp@postgres:5432/petapp
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Object storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=petapp
S3_SECRET_ACCESS_KEY=petappsecret
S3_BUCKET=petapp
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Android emulator: http://10.0.2.2:9000/petapp  |  iOS simulator: http://127.0.0.1:9000/petapp
S3_PUBLIC_BASE_URL=http://10.0.2.2:9000/petapp

# Mobile public config (copy values into mobile/.env as needed)
# Local Docker: http://10.0.2.2:8000/api/v1 (Android) / http://127.0.0.1:8000/api/v1 (iOS)
MOBILE_API_BASE_URL=https://api-production-6009.up.railway.app/api/v1
GOOGLE_MAPS_API_KEY=
